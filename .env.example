# Supabase PostgreSQL connection string
# Get from: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Use the "Transaction" pooler URL (port 6543) for serverless
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Admin password for the dashboard
APP_SECRET=your-strong-secret-password-here
